# Telegram Bot token from @BotFather
BOT_TOKEN=

# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# Telethon user session file name (without extension)
SESSION_NAME=adder_session

# Support chat ID. Users pressing Contact Support will send messages to this chat.
# If omitted, support messages go to superadmin.
SUPPORT_CHAT_ID=123456789

# Optional support username to expose direct t.me link in menu
SUPPORT_USERNAME=your_username

# Delay between invite attempts (seconds)
DEFAULT_DELAY_SECONDS=8

# Add random delay jitter in seconds: actual delay = base + random(0..jitter)
DELAY_JITTER_SECONDS=4

# Hard cap of CSV entries per run
MAX_PER_RUN=50

# Max allowed CSV file size in bytes
MAX_CSV_FILE_BYTES=1000000

# Cooldown between two CSV runs from same operator
RUN_COOLDOWN_SECONDS=900

# Stop run early after this many consecutive failures
MAX_CONSECUTIVE_FAILURES=8

# Send progress update every N processed users
PROGRESS_EVERY=10

# SQLite database path for users/uploads/admin state
DB_PATH=data/bot.db

# Directory where uploaded CSV files are archived
UPLOAD_ARCHIVE_DIR=data/uploads

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
